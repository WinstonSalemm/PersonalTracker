NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/personal_tracker?schema=public
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-before-seeding
APP_ORIGINS=http://localhost:3000
API_ENABLED=true
SNAPSHOT_READONLY_TOKEN=replace-with-a-separate-read-only-token
SNAPSHOT_USER_ID=
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_PROJECT_ID=
OPENAI_CAPTURE_MODEL=
OPENAI_CHAT_MODEL=
OPENAI_SUMMARY_MODEL=
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_OUTPUT_TOKENS=700
OPENAI_DAILY_USER_BUDGET=40
OPENAI_DAILY_TENANT_BUDGET=160
OPENAI_GLOBAL_DAILY_BUDGET=1000
KNOWLEDGE_MAX_DOCUMENT_BYTES=262144
KNOWLEDGE_MAX_ARCHIVE_BYTES=10485760
KNOWLEDGE_MAX_ARCHIVE_FILES=500
EMAIL_PROVIDER=development
EMAIL_FROM=beta@example.invalid
EMAIL_FROM_NAME=Personal Tracker Beta
# For the existing FinancialERP Brevo sender, use EMAIL_PROVIDER=brevo and set
# BREVO_API_KEY only in Railway variables (never in this file or Git).
# BREVO_API_KEY=
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USERNAME=
# SMTP_PASSWORD=
SMTP_SECURE=true
PUBLIC_APP_URL=http://localhost:3000
# EMAIL_VERIFICATION_URL=https://beta.example.com/verify-email
# PASSWORD_RESET_URL=https://beta.example.com/reset-password
# INVITATION_ACCEPT_URL=https://beta.example.com/accept-invitation
EMAIL_TOKEN_TTL_MINUTES=1440
RESET_RATE_LIMIT_MAX=5
INVITATION_RESEND_RATE_LIMIT_MAX=5
# Set true in production beta; development can use false for local smoke tests.
REQUIRE_EMAIL_VERIFICATION=false
REGISTRATION_CONSENT_VERSION=2026-08-06-v1
BETA_REGISTRATION_ENABLED=true
BETA_INVITATIONS_ENABLED=true
BETA_VAULT_IMPORT_ENABLED=true
AI_CREDITS_ENABLED=true
AI_BETA_STARTER_CREDITS=20
AI_CREDIT_PRICING_VERSION=beta-2026-08
AI_ALLOW_NEGATIVE_BALANCE=false
