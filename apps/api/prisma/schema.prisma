generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  normalizedEmail String        @unique
  passwordHash  String
  displayName   String
  status        UserStatus     @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  accounts      Account[]
  categories    Category[]
  transactions  Transaction[]
  obligations   Obligation[]
  english       EnglishProgress[]
  leads         Lead[]
  calls         CallActivity[]
  offers        Offer[]
  followUps     FollowUp[]
  dailyGoals    DailyGoal[]
  syncEvents    SyncEvent[]
  auditLogs     AuditLog[]
  sportMeasurements SportMeasurement[]
  workoutSessions WorkoutSession[]
  workoutExercises WorkoutExercise[]
  exerciseSets ExerciseSet[]
  basketballSessions BasketballSession[]
  recoveryCheckIns RecoveryCheckIn[]
  sportCheckpoints SportCheckpoint[]
  sportRoadmapDays SportRoadmapProgress[]
  memberships    TenantMembership[]
  invitedBy      Invitation[] @relation("InvitationInviter")
  knowledgeDocuments KnowledgeDocument[] @relation("KnowledgeAuthor")
  conversations  AiConversation[]
  aiMemories     AiMemory[] @relation("MemoryAuthor")
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  aiCreditWallets AICreditWallet[]
  aiCreditTransactions AICreditTransaction[]
  aiUsageRecords AIUsageRecord[]
  paymentOrders PaymentOrder[]
  registrationConsents RegistrationConsent[]
  canonicalMoneyCommits CanonicalMoneyCommit[]
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}
enum TenantType {
  PERSONAL
  TEAM
}
enum MembershipRole {
  OWNER
  MEMBER
}
enum MembershipStatus {
  ACTIVE
  SUSPENDED
}
enum InvitationStatus {
  PENDING
  REVOKED
  ACCEPTED
  EXPIRED
}
enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}
enum VaultImportStatus {
  DRY_RUN
  COMMITTED
  EXPIRED
}
enum KnowledgeSyncStatus {
  LOCAL
  SYNCED
  CONFLICT
  ERROR
}
enum MemoryStatus {
  EPHEMERAL
  SESSION
  CANDIDATE
  CONFIRMED
  SYSTEM_DERIVED
  REJECTED
}
enum AICreditWalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}
enum AICreditTransactionType {
  PURCHASE
  BONUS
  RESERVATION
  CHARGE
  RESERVATION_RELEASE
  REFUND
  ADJUSTMENT
  EXPIRATION
}
enum AIUsageStatus {
  RESERVED
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}
enum PaymentOrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

model Tenant {
  id          String             @id @default(uuid())
  name        String
  slug        String             @unique
  type        TenantType         @default(PERSONAL)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  memberships TenantMembership[]
  invitations Invitation[]
  knowledgeDocuments KnowledgeDocument[]
  conversations AiConversation[]
  memories    AiMemory[]
  auditEvents BetaAuditEvent[]
  aiCreditWallets AICreditWallet[]
  aiCreditTransactions AICreditTransaction[]
  aiUsageRecords AIUsageRecord[]
  paymentOrders PaymentOrder[]
}

model TenantMembership {
  id        String           @id @default(uuid())
  tenantId  String
  userId    String
  role      MembershipRole   @default(MEMBER)
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([tenantId, userId])
  @@index([userId, status])
}

model Invitation {
  id              String           @id @default(uuid())
  tenantId        String
  email           String
  normalizedEmail String
  role            MembershipRole   @default(MEMBER)
  tokenHash       String           @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  status          InvitationStatus @default(PENDING)
  deliveryStatus  DeliveryStatus   @default(PENDING)
  lastSentAt      DateTime?
  deliveryAttempts Int             @default(0)
  invitedByUserId String
  createdAt       DateTime         @default(now())
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy       User             @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  @@index([normalizedEmail, status, expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model RegistrationConsent {
  id              String   @id @default(uuid())
  userId          String
  documentVersion String
  locale          String
  acceptedAt      DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, acceptedAt])
}

model VaultImportSession {
  id             String            @id @default(uuid())
  tenantId       String
  userId         String
  archiveHash    String
  manifest       Json
  expiresAt      DateTime
  status         VaultImportStatus @default(DRY_RUN)
  createdAt      DateTime          @default(now())
  committedAt    DateTime?
  idempotencyKey String?
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, userId, expiresAt])
}

model KnowledgeDocument {
  id              String              @id @default(uuid())
  tenantId        String
  path            String
  title           String
  documentType    String
  content         String
  contentHash     String
  version         Int                 @default(1)
  createdByUserId String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  lastSyncedAt    DateTime?
  syncStatus      KnowledgeSyncStatus @default(LOCAL)
  isArchived      Boolean             @default(false)
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy       User                @relation("KnowledgeAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  @@unique([tenantId, path])
  @@index([tenantId, documentType, updatedAt])
}

model AiConversation {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  title     String?
  summary   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]
  @@index([tenantId, userId, updatedAt])
}

model AiMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           String
  content        String
  toolName       String?
  toolCallId     String?
  createdAt      DateTime @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}

model AiMemory {
  id             String       @id @default(uuid())
  tenantId       String
  createdByUserId String
  category       String
  content        String
  status         MemoryStatus @default(CANDIDATE)
  sourceConversationId String?
  approvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("MemoryAuthor", fields: [createdByUserId], references: [id], onDelete: Cascade)
  @@index([tenantId, status, updatedAt])
}

model AiCapturePreview {
  id             String   @id @default(uuid())
  tenantId       String
  userId         String
  type           String
  payload        Json
  expiresAt      DateTime
  committedAt    DateTime?
  confirmationId String?
  createdAt      DateTime @default(now())
  @@index([tenantId, userId, expiresAt])
  @@unique([tenantId, confirmationId])
}

model AICreditWallet {
  id                String               @id @default(uuid())
  tenantId          String
  userId            String
  balance           Int                  @default(0)
  reservedBalance   Int                  @default(0)
  lifetimePurchased Int                  @default(0)
  lifetimeSpent     Int                  @default(0)
  currency          String               @default("CREDITS")
  status            AICreditWalletStatus @default(ACTIVE)
  version           Int                  @default(1)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      AICreditTransaction[]
  @@unique([tenantId, userId])
  @@index([userId, status])
}

model AICreditTransaction {
  id             String                  @id @default(uuid())
  walletId       String
  tenantId       String
  userId         String
  type           AICreditTransactionType
  amount         Int
  balanceBefore  Int
  balanceAfter   Int
  reason         String
  referenceType  String?
  referenceId    String?
  idempotencyKey String                  @unique
  metadata       Json?
  createdAt      DateTime                @default(now())
  wallet         AICreditWallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([tenantId, userId, createdAt])
}

model AIUsageRecord {
  id                    String        @id @default(uuid())
  tenantId              String
  userId                String
  conversationId        String?
  requestId             String
  requestType           String
  provider              String
  model                 String
  inputTokens           Int           @default(0)
  cachedInputTokens     Int           @default(0)
  outputTokens          Int           @default(0)
  estimatedProviderCost Decimal?      @db.Decimal(12, 6)
  creditsReserved       Int           @default(0)
  creditsCharged        Int           @default(0)
  status                AIUsageStatus @default(RESERVED)
  failureReason         String?
  createdAt             DateTime      @default(now())
  completedAt           DateTime?
  tenant                Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([tenantId, requestId])
  @@index([tenantId, userId, createdAt])
}

model AICreditPackage {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  credits   Int
  price     Decimal  @db.Decimal(12, 2)
  currency  String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    PaymentOrder[]
}

model PaymentOrder {
  id                   String             @id @default(uuid())
  tenantId             String
  userId               String
  provider             String
  externalPaymentId    String?
  packageId            String?
  amount               Decimal            @db.Decimal(12, 2)
  currency             String
  credits              Int
  status               PaymentOrderStatus @default(PENDING)
  idempotencyKey       String             @unique
  createdAt            DateTime           @default(now())
  paidAt               DateTime?
  cancelledAt          DateTime?
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  package              AICreditPackage?   @relation(fields: [packageId], references: [id], onDelete: SetNull)
  @@index([tenantId, userId, status])
}

model BetaAuditEvent {
  id            String   @id @default(uuid())
  tenantId      String?
  userId        String?
  eventType     String
  entityType    String?
  entityId      String?
  success       Boolean  @default(true)
  durationMs    Int?
  correlationId String?
  metadata      Json?
  createdAt     DateTime @default(now())
  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  @@index([tenantId, eventType, createdAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model Account {
  id             String   @id @default(uuid())
  userId         String
  clientId       String
  name           String
  type           String
  currency       String
  initialBalance Float
  color          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, clientId])
}

model Category {
  id        String   @id @default(uuid())
  userId    String
  clientId  String
  name      String
  kind      String
  color     String?
  system    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, clientId])
}

model Transaction {
  id                String   @id @default(uuid())
  userId            String
  clientId          String
  accountId         String
  type              String
  amount            Float
  currency          String
  date              String
  counterparty      String?
  categoryId        String?
  purpose           String?
  paymentMethod     String?
  transferToAccountId String?
  recurring         Boolean  @default(false)
  status            String
  incomeSource      String?
  comment           String?
  obligationId      String?
  essential         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, clientId])
  @@index([userId, date])
  @@index([userId, type, status])
}

model CanonicalMoneyCommit {
  id              String   @id @default(uuid())
  userId          String
  captureId       String
  exactMinorUnits String
  currency        String
  direction       String
  date            String
  description     String
  accountId       String
  categoryId      String?
  paymentMethod   String?
  intentJson      Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, captureId])
  @@index([userId, createdAt])
}

model Obligation {
  id           String   @id @default(uuid())
  userId       String
  clientId     String
  name         String
  totalAmount  Float
  paidAmount   Float
  currency     String
  dueDate      String
  recurrence   String
  comment      String?
  status       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, clientId])
  @@index([userId, dueDate])
}

model EnglishProgress {
  id             String   @id @default(uuid())
  userId         String
  clientId       String
  date           String
  overallProgress Float
  completedDays  Int
  activeDay      Int
  streak         Int
  studyMinutes   Int
  payload        Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, clientId])
  @@index([userId, date])
}

model Lead {
  id          String   @id @default(uuid())
  userId      String
  clientId    String
  companyName String
  contactName String?
  position    String?
  phone       String?
  telegram    String?
  city        String?
  niche       String?
  source      String
  companyUrl  String?
  comment     String?
  status      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, clientId])
  @@index([userId, source, status])
}

model CallActivity {
  id              String   @id @default(uuid())
  userId          String
  clientId        String
  leadId          String
  attemptNumber   Int
  dateTime        DateTime
  result          String
  whatSaid        String?
  problem         String?
  offered         String?
  objection       String?
  nextStep        String?
  nextContactDate String?
  comment         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, clientId])
  @@index([userId, dateTime])
  @@index([userId, result])
}

model Offer {
  id              String   @id @default(uuid())
  userId          String
  clientId        String
  leadId          String
  serviceName     String
  taskDescription String?
  amount          Float
  currency        String
  probability     Int
  decisionDate    String?
  status          String
  proposalUrl     String?
  comment         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, clientId])
  @@index([userId, status])
}

model FollowUp {
  id        String   @id @default(uuid())
  userId    String
  clientId  String
  leadId    String
  date      String
  reason    String
  lastResult String?
  nextStep  String?
  status    String
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, clientId])
  @@index([userId, date, status])
}

model DailyGoal {
  id        String   @id @default(uuid())
  userId    String
  clientId  String
  date      String
  kind      String
  target    Int
  achieved  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, clientId])
  @@index([userId, date, kind])
}

model SyncEvent {
  id           String   @id @default(uuid())
  userId       String
  batchId      String
  entity       String
  clientId     String
  operation    String
  payloadHash  String
  createdAt    DateTime @default(now())
  syncedAt     DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, entity, clientId])
  @@index([userId, syncedAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  method    String
  route     String
  requestId String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([createdAt, action])
}

model SportMeasurement {
  id String @id @default(uuid())
  userId String
  clientId String
  date String
  weightKg Float?
  waistCm Float?
  abdomenCm Float?
  chestCm Float?
  bicepsLeftCm Float?
  bicepsRightCm Float?
  thighLeftCm Float?
  thighRightCm Float?
  bodyFatPercent Float?
  comment String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, clientId])
  @@index([userId, date])
}

model WorkoutSession {
  id String @id @default(uuid())
  userId String
  clientId String
  roadmapDayNumber Int?
  date String
  workoutType String
  workoutTemplate String?
  startedAt DateTime
  finishedAt DateTime?
  durationMinutes Int?
  planned Boolean @default(false)
  completed Boolean @default(false)
  perceivedDifficulty Int?
  energyBefore Int?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, clientId])
  @@index([userId, date, workoutType])
}

model WorkoutExercise {
  id String @id @default(uuid())
  userId String
  clientId String
  workoutSessionClientId String
  exerciseId String?
  nameSnapshot String
  primaryMuscleSnapshot String
  targetSets Int
  targetRepRange String
  completed Boolean @default(false)
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, clientId])
  @@index([userId, workoutSessionClientId])
}

model ExerciseSet {
  id String @id @default(uuid())
  userId String
  clientId String
  workoutExerciseClientId String
  setNumber Int
  weight Float
  repetitions Int
  rpe Int?
  rir Int?
  completed Boolean @default(false)
  warmup Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, clientId])
  @@index([userId, workoutExerciseClientId])
}

model BasketballSession {
  id String @id @default(uuid())
  userId String
  clientId String
  date String
  durationMinutes Int
  format String
  intensity Int
  gamesPlayed Int
  kneeDiscomfort Int
  ankleDiscomfort Int
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, clientId])
  @@index([userId, date])
}

model RecoveryCheckIn {
  id String @id @default(uuid())
  userId String
  clientId String
  date String
  sleepHours Float
  sleepQuality Int
  energy Int
  muscleSoreness Int
  jointPain Int
  stress Int
  motivation Int
  comment String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, clientId])
  @@index([userId, date])
}

model SportCheckpoint {
  id String @id @default(uuid())
  userId String
  clientId String
  dayNumber Int
  date String
  label String
  notes String?
  completed Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, clientId])
  @@index([userId, date])
}

model SportRoadmapProgress {
  id String @id @default(uuid())
  userId String
  clientId String
  dayNumber Int
  date String
  phase Int
  plannedActivity String
  workoutTemplate String?
  status String
  skipReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, clientId])
  @@index([userId, dayNumber])
}
